# Dependencies
/vendor
/node_modules

# Environment and secrets
.env
.env.*
!.env.example
!.env.production.example
auth.json
*.key

# Laravel generated files
/public/build
/public/hot
/public/storage
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep
/storage/*.key
/storage/app/*
!/storage/app/.gitkeep
!/storage/app/public
!/storage/app/private
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/app/private/*
!/storage/app/private/.gitkeep
!/storage/app/private/backups
/storage/app/private/backups/*
!/storage/app/private/backups/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
!/storage/framework/cache/data
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Runtime uploads and backups
/public/uploads/productos/*
!/public/uploads/productos/.gitkeep
/public/uploads/empresa/*
!/public/uploads/empresa/.gitkeep
!/public/uploads/empresa/beniglow-logo.png
/public/backups/*
!/public/backups/.gitkeep
!/public/backups/.htaccess

# Test and tool caches
.phpunit.result.cache
/.phpunit.cache
/coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local editor and OS files
/.fleet
/.idea
/.vscode
.DS_Store
Thumbs.db

# Local deploy artifacts
*.tgz
*.tar.gz
*.zip
deploy-*.log
